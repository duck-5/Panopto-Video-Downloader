{
	"update_url": "https://clients2.google.com/service/update2/crx",
	"name": "Panopto Video Downloader",
	"version": "1.6",
	"description": "Download multi-screen videos from Panopto and watch synchronously in the Smart Dual-Screen Viewer.",
	"manifest_version": 3,
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"action": {
		"default_icon": "icon.png",
		"default_popup": "popup.html"
	},
	"permissions": [
		"activeTab",
		"downloads",
		"scripting",
		"storage"
	]
}
